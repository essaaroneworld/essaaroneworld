[Unit]
Description=PW Batch Online Examination System (ESS AAR SOFTEK PLC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pwexam
Group=pwexam
WorkingDirectory=/opt/pwexam
EnvironmentFile=/etc/pwexam.env
ExecStart=/usr/bin/python3 -m pwexam --no-prompt --host 127.0.0.1 --port 8080 --data /var/lib/pwexam/pwexam.db
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pwexam
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
