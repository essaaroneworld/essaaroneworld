# ---- required ---------------------------------------------------------------
PWEXAM_DOMAIN=exam.example.com
# Password for the first 'admin' account (only used when no admin exists yet).
PWEXAM_ADMIN_PASSWORD=ChangeMe2026
# Long random string used to sign login sessions (generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
PWEXAM_SECRET=

# ---- optional ---------------------------------------------------------------
PWEXAM_TIMEZONE=Asia/Kolkata
# Require a one-time password (sent by email/SMS) at candidate / staff login.
PWEXAM_CANDIDATE_OTP=0
PWEXAM_STAFF_OTP=0

# Email (SMTP)
PWEXAM_SMTP_HOST=
PWEXAM_SMTP_PORT=587
PWEXAM_SMTP_USER=
PWEXAM_SMTP_PASSWORD=
PWEXAM_SMTP_FROM=exams@example.com
PWEXAM_SMTP_TLS=1

# SMS gateway: the exam server POSTs {"to": "<mobile>", "message": "<text>"} as JSON to this URL.
PWEXAM_SMS_WEBHOOK=
PWEXAM_SMS_TOKEN=
